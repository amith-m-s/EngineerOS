# ═══════════════════════════════════════════════════════════════════
# EngineerOS — Environment Configuration
# Copy this file to .env.local and customize for your environment
# ═══════════════════════════════════════════════════════════════════

# ── Frontend ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ── Backend (used by docker-compose & uvicorn) ────────────────────
ENVIRONMENT=development
DEBUG=true
API_TITLE=EngineerOS API
API_VERSION=1.0.0

# ── Security ──────────────────────────────────────────────────────
JWT_SECRET_KEY=dev-secret-change-in-production-immediately
JWT_EXPIRATION_HOURS=24

# ── Database ──────────────────────────────────────────────────────
POSTGRES_DSN=sqlite:///./engineeros_dev.db
# For Docker: postgresql+psycopg2://engineeros:engineeros@postgres:5432/engineeros

# ── Graph Database ────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── Vector Database ───────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ── Cache ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Message Queue ─────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Observability (optional) ──────────────────────────────────────
# SENTRY_DSN=
# OTLP_ENABLED=false
# OTLP_ENDPOINT=http://localhost:4317

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
